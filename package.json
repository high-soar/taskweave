{
  "name": "taskweave",
  "version": "0.1.0",
  "description": "コーディングエージェント向けのスケジュール調整ツール",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:index": "node scripts/okf-docs.mjs index",
    "docs:check": "node scripts/okf-docs.mjs check",
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "node scripts/typecheck.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
