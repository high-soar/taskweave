{
  "name": "taskweave",
  "version": "0.1.0",
  "description": "コーディングエージェント向けのスケジュール調整ツール",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:index": "node scripts/okf-docs.mjs index",
    "docs:check": "node scripts/okf-docs.mjs check",
    "lint": "eslint .",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test test/okf-docs.test.mjs",
    "test:python": "uv run --project python pytest python/tests",
    "typecheck": "node scripts/typecheck.mjs",
    "validate": "uv run --project python taskweave validate"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
