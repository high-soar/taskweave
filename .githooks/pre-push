#!/bin/sh

set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

# Unset Git environment variables so nested git operations in tests target their own directories
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX

echo "Running format check before push..."
npm run format:check

echo "Running OKF documentation check before push..."
npm run docs:check

echo "Running lint before push..."
npm run lint

echo "Running tests before push..."
npm test

echo "Running typecheck before push..."
npm run typecheck